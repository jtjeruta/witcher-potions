<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Swallow -->
  <RecipeDef Name="WitcherPotion_SwallowRecipeShared" Abstract="True">
    <label>make swallow</label>
    <description>Brew a green witcher healing draught from foraged myrleaf, herbal medicine, and alcohol.</description>
    <jobString>Brewing swallow.</jobString>
    <workAmount>900</workAmount>
    <researchPrerequisite>Witcher_Alchemy</researchPrerequisite>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MedicineHerbal</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>WitcherHerb_Myrleaf</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Beer</li>
          </thingDefs>
          <customSummary>alcohol</customSummary>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MedicineHerbal</li>
        <li>WitcherHerb_Myrleaf</li>
        <li>Beer</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <WitcherPotion_Swallow>1</WitcherPotion_Swallow>
    </products>
  </RecipeDef>

  <RecipeDef ParentName="WitcherPotion_SwallowRecipeShared">
    <defName>Make_WitcherPotion_Swallow</defName>
    <workSkill>Intellectual</workSkill>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Drug</soundWorking>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
  </RecipeDef>

  <RecipeDef ParentName="WitcherPotion_SwallowRecipeShared">
    <defName>Make_WitcherPotion_Swallow_Campfire</defName>
    <workSkill>Cooking</workSkill>
    <workSpeedStat>DrugCookingSpeed</workSpeedStat>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <recipeUsers>
      <li>Campfire</li>
    </recipeUsers>
  </RecipeDef>

