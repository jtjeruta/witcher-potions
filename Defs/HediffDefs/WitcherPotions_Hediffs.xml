<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>WitcherPotion_SwallowHediff</defName>
    <label>swallow</label>
    <description>Mutagenic reagents are knitting wounds shut and slowing blood loss. The body is working overtime to purge the toxins.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.35, 0.85, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>7500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="WitcherPotions.HediffCompProperties_HealOverTime">
        <ticksInterval>120</ticksInterval>
        <healAmount>0.6</healAmount>
        <stopBleeding>true</stopBleeding>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>WitcherPotion_ThunderboltHediff</defName>
    <label>thunderbolt</label>
    <description>Combat reflexes are heightened and strikes land harder. The heart races from the toxic surge.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.95, 0.80, 0.20)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>5000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <MeleeDamageFactor>1.30</MeleeDamageFactor>
          <MoveSpeed>1.10</MoveSpeed>
          <AimingDelayFactor>0.85</AimingDelayFactor>
        </statFactors>
        <statOffsets>
          <MeleeHitChance>4</MeleeHitChance>
          <ShootingAccuracyPawn>4</ShootingAccuracyPawn>
          <PainShockThreshold>0.20</PainShockThreshold>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>0.05</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
